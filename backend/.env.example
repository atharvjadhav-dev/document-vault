# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=document_vault
DB_USER=vault_user
DB_PASSWORD=vault_secure_password
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=2000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRES_IN=7d

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
# 10 MB = 10 * 1024 * 1024

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: 'local' | 's3'
STORAGE_TYPE=local
UPLOAD_PATH=./uploads

# AWS S3 (only needed when STORAGE_TYPE=s3)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET_NAME=document-vault-files

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
