# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# PRODUCTION (Amazon RDS PostgreSQL):
# DB_HOST=docvault-postgres.<unique-id>.ap-south-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=document_vault
# DB_USER=vault_user
# DB_PASSWORD=[SUPPLIED_SECURELY_AT_DEPLOYMENT]
# DB_SSL=true
# DB_CA_CERT_PATH=/app/src/config/certs/global-bundle.pem

# DEVELOPMENT (Local PostgreSQL):
DB_HOST=postgres
DB_PORT=5432
DB_NAME=document_vault
DB_USER=vault_user
DB_PASSWORD=vault_secure_password
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=2000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRES_IN=7d

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
# 10 MB = 10 * 1024 * 1024

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: 'local' | 's3'
STORAGE_TYPE=local
UPLOAD_PATH=./uploads

# AWS S3 (only needed when STORAGE_TYPE=s3)
# PRODUCTION (AWS EC2):
# The application automatically uses the EC2 IAM Instance Profile / IMDS.
# Do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in production.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=document-vault-files

# DEVELOPMENT ONLY (Optional - for local testing without IAM roles):
# AWS_ACCESS_KEY_ID=your-local-dev-access-key
# AWS_SECRET_ACCESS_KEY=your-local-dev-secret-key

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://doc.atharvjadhav.xyz,https://document-vault.atharvjadhav.xyz

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
